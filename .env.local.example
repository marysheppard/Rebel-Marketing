NEXT_PUBLIC_SUPABASE_URL=YOUR_PROJECT_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY_HERE

# Public app URL (links in the portal / notifications if needed)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase service role.
# Required to auto-create client portal Auth users on contract Finalize.
# NEVER prefix with NEXT_PUBLIC_ or import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Public homepage FAQ chat (Vercel AI Gateway). Required for public Ask Rebel on /.
# Get a key from the Vercel dashboard (AI Gateway) or `vercel env pull`.
AI_GATEWAY_API_KEY=YOUR_AI_GATEWAY_API_KEY_HERE

# Do NOT put service-role or secret keys in this file or in any frontend code.

# Contract signing uses the authenticated client portal only (no Resend / temp codes).

# In-app Rebel Assistant (OpenAI). Required for the floating help chat in /app.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
