NEXT_PUBLIC_SUPABASE_URL=YOUR_PROJECT_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY_HERE

# Public app URL used in signing / activation invitation links
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional: Resend for real email delivery (server-only — never expose to the browser)
# When unset, invitations are simulated and previewed once in the agency UI.
RESEND_API_KEY=
EMAIL_FROM=Rebel Marketing <onboarding@resend.dev>

# Server-only Supabase service role (Auth admin: createUser / email-exists checks).
# NEVER prefix with NEXT_PUBLIC_ or import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Public homepage FAQ chat (Vercel AI Gateway). Required for /api/chat.
# Get a key from the Vercel dashboard (AI Gateway) or `vercel env pull`.
AI_GATEWAY_API_KEY=YOUR_AI_GATEWAY_API_KEY_HERE

# Do NOT put service-role or secret keys in this file or in any frontend code.
